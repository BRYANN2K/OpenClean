	<key>Nothing over %@ that hasn’t been opened in %lld days. Try a smaller size.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Nichts über %1$@, das seit %2$#@days@ nicht geöffnet wurde. Versuche eine kleinere Größe.</string>
