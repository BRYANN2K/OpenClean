			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Diese Objekte kommen in die Quarantäne. Du kannst sie %lld Tag lang aus dem Verlauf wiederherstellen; danach werden sie gelöscht.</string>
			<key>other</key>
			<string>Diese Objekte kommen in die Quarantäne. Du kannst sie %lld Tage lang aus dem Verlauf wiederherstellen; danach werden sie gelöscht.</string>
		</dict>
	</dict>
