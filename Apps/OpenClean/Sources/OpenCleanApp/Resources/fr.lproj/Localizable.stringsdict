	<key>Nothing over %@ that hasn’t been opened in %lld days. Try a smaller size.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Rien au-delà de %1$@ qui n’a pas été ouvert depuis %2$#@days@. Essayez une taille plus petite.</string>
