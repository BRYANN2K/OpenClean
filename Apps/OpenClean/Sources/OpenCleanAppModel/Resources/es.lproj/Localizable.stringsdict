<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ was moved to quarantine. You can restore it from History for %lld days; it loads again at your next login.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@ se movió a cuarentena. Puedes restaurarlo desde el Historial durante %2$#@days@; se cargará de nuevo en tu próximo inicio de sesión.</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld día</string>
			<key>other</key>
			<string>%2$lld días</string>
		</dict>
	</dict>
	<key>%lld items were left in place</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ítem se quedó donde estaba</string>
			<key>other</key>
			<string>%lld ítems se quedaron donde estaban</string>
		</dict>
	</dict>
</dict>
</plist>
