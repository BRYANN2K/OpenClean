<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ was moved to quarantine. You can restore it from History for %lld days; it loads again at your next login.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@ was moved to quarantine. You can restore it from History for %2$#@days@; it loads again at your next login.</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld day</string>
			<key>other</key>
			<string>%2$lld days</string>
		</dict>
	</dict>
	<key>%lld items were left in place</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld item was left in place</string>
			<key>other</key>
			<string>%lld items were left in place</string>
		</dict>
	</dict>
</dict>
</plist>
