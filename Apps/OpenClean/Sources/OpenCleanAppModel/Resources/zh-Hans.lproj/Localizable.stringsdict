<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ was moved to quarantine. You can restore it from History for %lld days; it loads again at your next login.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@ 已移入隔离区。你可以在 %2$#@days@内从“历史记录”恢复它；它会在你下次登录时再次载入。</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%2$lld 天</string>
		</dict>
	</dict>
	<key>%lld items were left in place</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>有 %lld 个项目保留在原处</string>
		</dict>
	</dict>
</dict>
</plist>
